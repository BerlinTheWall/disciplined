<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Outlook OAuth callback deep link (Settings > Connected
                 Calendars) — the backend's /api/outlook/callback redirects
                 here once Microsoft's login/consent finishes, so the in-app
                 browser (@capacitor/browser) hands control back to the app.
                 See frontend/src/lib/outlookAuth.ts. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.hooman.disciplined" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ReminderTtsPlugin: speaks a reminder aloud on-device when its
             alarm fires, since Android can't play a runtime-generated file as
             a scheduled notification's sound (see ReminderTtsPlugin.java). -->
        <receiver
            android:name=".ReminderTtsReceiver"
            android:exported="false" />
        <service
            android:name=".ReminderTtsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="reminder_text_to_speech" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connected Calendars (Settings) — read/write access to the device's
         calendar provider (Google/Outlook/etc. accounts already added in
         Android Settings), via @ebarooni/capacitor-calendar. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Without this, Android refuses to let the alarm-triggered
         ReminderTtsReceiver start ReminderTtsService in the background at
         all (ForegroundServiceStartNotAllowedException) — see
         ReminderTtsPlugin's requestBatteryExemption. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets reminders speak within a second or two of firing instead of
         drifting by several seconds — see ReminderTtsPlugin.scheduleAlarm. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
