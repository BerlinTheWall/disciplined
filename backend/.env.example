# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Natural-voice reminders (Google Cloud Text-to-Speech). Create a key in a
# Google Cloud project with the "Cloud Text-to-Speech API" enabled:
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_TTS_API_KEY=

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Never deploy with the built-in default — anyone who knows it can forge a login.
JWT_SECRET=

# Transactional email (signup verification codes, password reset). Blank in
# dev is fine — the code is just logged instead of sent. Get a key at
# https://resend.com/api-keys; the default sender below is Resend's shared
# sandbox domain, which only delivers to the address you signed up with —
# verify your own domain and set EMAIL_FROM once real users need mail.
RESEND_API_KEY=
# EMAIL_FROM=Disciplined <onboarding@resend.dev>

# Postgres. This default matches docker-compose.yml, so `docker compose up -d`
# and you are connected. Railway injects its own DATABASE_URL in production —
# the plain postgresql:// form is fine, the app rewrites it for asyncpg.
DATABASE_URL=postgresql+asyncpg://disciplined:disciplined@localhost:5432/disciplined

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash-lite
# ACCESS_TOKEN_EXPIRE_MINUTES=43200
